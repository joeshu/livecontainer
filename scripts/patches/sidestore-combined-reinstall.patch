diff --git a/AltStore/Core/Utilities/SideStoreLocalization.swift b/AltStore/Core/Utilities/SideStoreLocalization.swift
new file mode 100644
index 00000000..81546d19
--- /dev/null
+++ b/AltStore/Core/Utilities/SideStoreLocalization.swift
@@ -0,0 +1,32 @@
+import Foundation
+
+// Resolve resources from the SideStore image, never from the LiveContainer host.
+private final class SideStoreLocalizationBundleMarker: NSObject {}
+
+enum SideStoreLocalization {
+    static let resourceBundle = Bundle(for: SideStoreLocalizationBundleMarker.self)
+
+    static var language: String {
+        SideStoreLanguagePolicy.resolve(
+            preference: UserDefaults.standard.string(forKey: SideStoreLanguagePolicy.preferenceKey),
+            inheritedLanguages: SideStoreLanguagePolicy.inheritedLanguages()
+        )
+    }
+
+    static var locale: Locale { Locale(identifier: language + (Locale.current.regionCode.map { "_" + $0 } ?? "")) }
+
+    static func text(_ key: String, default fallback: String, table: String = "CombinedLocalizable") -> String {
+        // Use a sentinel so a translated value identical to its key is not
+        // mistaken for a missing translation. Fall back to English explicitly.
+        LocalizedResourceLookup.text(bundle: resourceBundle, language: language,
+                                     key: key, fallback: fallback, table: table)
+    }
+
+    static func legacyText(_ key: String, table: String = "Localizable") -> String {
+        text(key, default: key, table: table)
+    }
+
+    static func format(_ key: String, default fallback: String, _ arguments: CVarArg...) -> String {
+        String(format: text(key, default: fallback), locale: locale, arguments: arguments)
+    }
+}
