diff --git a/Shared/Localization/LocalizedResourceLookup.swift b/Shared/Localization/LocalizedResourceLookup.swift
new file mode 100644
index 00000000..5f4b6aa9
--- /dev/null
+++ b/Shared/Localization/LocalizedResourceLookup.swift
@@ -0,0 +1,16 @@
+import Foundation
+
+/// Lookup in the owning module, with an explicit English fallback.
+public enum LocalizedResourceLookup {
+    public static func text(bundle: Bundle, language: String, key: String,
+                            fallback: String, table: String) -> String {
+        let missing = "__SideStoreLocalizationMissing__"
+        for code in [language, "en", "Base"] {
+            guard let path = bundle.path(forResource: code, ofType: "lproj"),
+                  let localizedBundle = Bundle(path: path) else { continue }
+            let value = localizedBundle.localizedString(forKey: key, value: missing, table: table)
+            if value != missing { return value }
+        }
+        return fallback
+    }
+}
diff --git a/Shared/Localization/SideStoreLanguagePolicy.swift b/Shared/Localization/SideStoreLanguagePolicy.swift
new file mode 100644
index 00000000..03a844cb
--- /dev/null
+++ b/Shared/Localization/SideStoreLanguagePolicy.swift
@@ -0,0 +1,32 @@
+import Foundation
+
+/// A process-independent policy shared by foreground UI, extensions and tests.
+/// "system" follows the containing app's languages when embedded in LiveContainer.
+public enum SideStoreLanguagePolicy {
+    public static let preferenceKey = "SideStorePreferredLanguage"
+    public static let supportedLanguages = ["en", "zh-Hans", "zh-Hant"]
+
+    public static func resolve(preference: String?, inheritedLanguages: [String]) -> String {
+        if let preference, supportedLanguages.contains(preference) { return preference }
+        for identifier in inheritedLanguages {
+            let parts = identifier.replacingOccurrences(of: "_", with: "-").lowercased().split(separator: "-")
+            guard let language = parts.first else { continue }
+            if language == "en" { return "en" }
+            if language == "zh" {
+                if parts.contains("hant") { return "zh-Hant" }
+                if parts.contains("hans") { return "zh-Hans" }
+                return parts.contains(where: { ["tw", "hk", "mo"].contains(String($0)) }) ? "zh-Hant" : "zh-Hans"
+            }
+        }
+        return "en"
+    }
+
+    public static func inheritedLanguages(environment: [String: String] = ProcessInfo.processInfo.environment,
+                                          fallback: [String] = Locale.preferredLanguages) -> [String] {
+        guard let value = environment["LC_HOST_LANGUAGES"],
+              let data = value.data(using: .utf8),
+              let languages = try? JSONDecoder().decode([String].self, from: data),
+              !languages.isEmpty else { return fallback }
+        return languages
+    }
+}
