    "lc.settings.signer.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أذا أعطى AltSign خطأ، فحاول أن تستعمل Zsign و العكس صحيح. الرجاء اعادة تشغيل التطبيق LiveContainer بعد تغيير الُموقع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn AltSign einen Fehler meldet, versuchen Sie es bitte mit ZSign und andersherum. Bitte starten Sie LiveContainer nach dem Wechsel des Signierers neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If AltSign reports an error, please try ZSign and vice versa. Please restart LiveContainer after switching Signer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si AltSign signale une erreur, essayez ZSign et vice versa. Veuillez redémarrer LiveContainer après avoir changé de signataire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltSign でエラーが発生する場合は、ZSign をお試しください。また、反対にZSignでエラーが発生する場合は、AltSignをお試しください。Signer を切り替えた後、 LiveContainer を再起動してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se AltSign não funcionar corretamente, por favor tente mudar para ZSign e vice-versa. Por favor, reinicie LiveContainer após alterar o método de assinar os aplicativos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om AltSign rapporterar ett fel, försök ZSign och vice versa. Starta om LiveContainer efter byte av Signer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若AltSign签名遇到问题，可尝试使用ZSign，反之亦然。切换签名工具后请重启LiveContainer。"
          }
        }
      }
    },
