    "lc.settings.silentSwitchAppDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالأساس، LiveContainer سوف يسألك قبل تغيير البرنامَج. فعل هذا الخيار لتحويل البرنامَج مباشره دون سؤال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig fragt LiveContainer Sie, bevor Sie die App wechseln. Aktivieren Sie dies, um die App sofort zu wechseln. Alle ungespeicherten Daten gehen dabei verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, LiveContainer asks you before switching app. Enable this to switch app immediately. Any unsaved data will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por defecto, LiveContainer te pregunta antes de cambiar de app. Activa esto para cambiar de app inmediatamente. Se perderán los datos no guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, LiveContainer vous demande votre avis avant de changer d'application. Activez cette option pour changer d'application immédiatement. Toutes les données non sauvegardées seront perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di default, LiveContainer ti chiede prima di cambiare app. Abilita questa opzione per cambiare app immediatamente. Tutti i dati non salvati andranno persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、LiveContainerはアプリを切り替える前に尋ねます。これをオンにすると、アプリをすぐに切り替えることができます。保存していないデータは失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 옵션을 활성화할 경우 경고 없이 앱이 바로 전환됩니다. 저장하지 않은 데이터는 지워집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie, LiveContainer pyta Cię o zgodę przed zmienieniem aplikacji. Włącz tę opcję, aby zmieniać aplikacje natychmiast. Stracisz dane, które nie zostały zapisane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente, o LiveContainer irá perguntar se você quer mesmo trocar de aplicativo. Ative esta opção para trocar de aplicativo imediatamente. Qualquer dado não salvo será perdido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию LiveContainer будет спрашивать вас перед переключением приложений. Включите эту опцию, чтобы переключать приложения немедленно. Все несохраненные данных могут быть потеряны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som standard frågar LiveContainer dig innan du byter app. Aktivera detta för att byta app direkt. Alla osparade data kommer att gå förlorade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak, LiveContainer uygulama değiştirmeden önce size sorar. Uygulamayı hemen değiştirmek için bunu etkinleştirin. Kaydedilmemiş veriler kaybolacaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định LiveContainer sẽ hỏi bạn trước khi chuyển sang app khác. Bật tuỳ chọn này để chuyển app luôn. Dữ liệu chưa lưu sẽ bị mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LiveContainer在切换App时默认会向你确认。启用此选项来静默切换，所有未保存的数据将会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LiveContainer在切換App時預設會向你確認。啟用此選項來直接切換，所有未儲存的資料將會遺失。"
          }
        }
      }
    },
