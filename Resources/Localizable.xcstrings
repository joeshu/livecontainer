    "lc.settings.strictHidingDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفعيل هذا الوضع سيسمح للتطبيقات المخفية أن تُشغل بالضغط عليها ثلاث مرات في عداد التطبيقات المثبته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie diesen Modus aktivieren, können versteckte Anwendungen nur durch Dreifachklick auf die Anzahl der installierten Anwendungen gestartet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabling this mode will only allow hidden apps to be launched by triple clicking the installed app counter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilitar este modo solo permitirá que se inicien aplicaciones ocultas haciendo clic tres veces en el contador de aplicaciones instaladas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'activation de ce mode ne permet de lancer les applications masquées que par un triple appui sur le compteur d'applications installées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitando questa modalità, permetterà solo alle app nascoste di essere lanciate cliccando 3 volte nel contatore delle app installate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモードをオンにすると、非表示のアプリはインストール済みアプリの合計カウンターを3回クリックすることでのみ起動できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화할 경우, 앱 목록 하단에 '총 n개'를 연속으로 세 번 눌러야 숨긴 앱이 보입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączając tę opcję, ukryte aplikacje będzie można uruchomić po trzykrotnym naciśnięciu licznika aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar esta opção irá fazer com que apenas aplicativos escondidos serão autorizados ao executa-los ao clicar três vezes no contador de aplicativos instalados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включение этого режима позволит вам просмотреть скрытые приложения тройным нажатием на счётчик установленных приложений."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering av detta läge tillåter bara dolda appar att startas genom att tredubbla att klicka på den installerade appräknaren."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu modu etkinleştirdiğinizde, gizli uygulamalar yalnızca yüklü uygulama sayacına üç kez tıklayarak başlatılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật chế độ này chỉ cho các app bị ẩn được mở bằng cấp nhấn 3 lần vào chỗ đếm số app đã được cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，将只能从App选择界面启动App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，將只能從App選擇介面啟動App。"
          }
        }
      }
    },
