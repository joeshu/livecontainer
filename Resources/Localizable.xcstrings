    "lc.appSettings.fixFilePickerDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اصلح لاقط الملفات عندما لا يستجيب عند ضغط 'فتح' بأجبار هذا التطبيق على نسخ الملفات المحدده في صندوق الوارد الخاص به. يمكنك مشاهده الملفات المستورده في 'صندوق الوارد' في ملف بيانات التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behebt das Problem, dass der Dateiauswahldialog beim Tippen auf \"Öffnen\" nicht reagiert, indem die App die ausgewählten Dateien in ihren Inbox-Ordner kopiert. Importierte Dateien finden Sie im Ordner \"Inbox\" im Datenordner der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixes the issue of File Picker not responding when hitting 'open' by forcing this app to copy selected files to its inbox. You may view imported files in the 'Inbox' folder in app's data folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige el problema del selector de archivos que no responde al pulsar 'abrir', forzando a esta app a copiar los archivos seleccionados en su bandeja de entrada. Puedes ver los archivos importados en la carpeta 'Inbox' dentro de la carpeta de datos de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigez le fait que le sélecteur de fichiers ne répond pas lorsque vous appuyez sur \"ouvrir\" en forçant cette application à copier les fichiers sélectionnés dans sa boîte de réception. Vous pouvez voir les fichiers importés dans le dossier \"Inbox\" du dossier de données de l'application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema il selettore file che non risponde quando clicchi 'apri' forzando l'app a copiare i file selezionati. Potresti vedere i file importati nella cartella 'Inbox' nella cartella dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したファイルを受信トレイにコピーするように強制することで、｢開く｣を押しても反応しない問題を修正します。インポートしたファイルはアプリのデータフォルダ内の｢受診トレイ｣フォルダに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 선택기에서 '열기' 버튼을 누르고 응답이 없을 때, 강제로 파일을 복사합니다. 복사한 파일은 앱 데이터 폴더 안에 있는 'Inbox' 폴더에 나타날 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprawia problem gdzie wybieracz plików nie odpowiada przy naciśnięciu \"Otwórz\" zmuszając aplikację do skopiowania wybranych plików do jej inbox’u. Możesz zobaczyć zaimportowane pliki w katalogu o nazwie \"nbox\" w katalogu danych aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative esta opção caso o 'File Picker' não fazer nada quando o botão 'Abrir' é pressionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исправить не отвечающее меню выбора файлов при нажатии \"открыть\", заставляя это приложение копировать файлы в папку \"Inbox\" в папке данных приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixa filväljaren som inte svarar när du trycker på 'öppna' genom att tvinga denna app att kopiera markerade filer till sin inkorg. Du kan se importerade filer i mappen 'Inkorg' i appens datamapp."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya seçici düzeltme, ‘aç’ düğmesine basıldığında yanıt vermeme sorununu, bu uygulamanın seçilen dosyaları gelen kutusuna kopyalamasını zorlayarak giderir. İçe aktarılan dosyaları, uygulamanın veri klasöründeki ‘Gelen Kutusu’ klasöründe görüntüleyebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sửa trình chọn file không phản hồi khi nhấn 'mở' bằng cách buộc app chép các file đã chọn vào Inbox của nó. Bạn có thể xem các file đã nhập trong thư mục 'Inbox' trong thư mục dữ liệu app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若导入文件时点击“打开”没有反应，可启用本选项。启用后所有导入的文件会被复制到App数据文件夹的Inbox目录下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過強制此應用程式將選定的檔案複製到其收件箱，修復檔案選擇器在點選「開啟」時沒有響應的問題。 您可以在應用程式資料資料夾中的「Inbox」資料夾中檢視匯入的檔案。"
          }
        }
      }
    },
