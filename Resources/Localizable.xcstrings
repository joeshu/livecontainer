    "lc.appSettings.addExternalNonLocalContainerWarningAlert" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة حاوية في وحدة تخزين غير محلية غير مدعومة من معظم التطبيقات وسوف يسبب سلوكا غير محدد بما في ذلك التعطل. هل تريد المتابعة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hinzufügen von Containern in einem nicht lokalen Speicher wird von den meisten Apps nicht unterstützt und führt zu unvorhersehbaren Verhaltensweisen, einschließlich Abstürzen. Fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding a container in a non-local storage is not supported by most apps and will result in undefined behavior including crash. Continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir un contenedor en un almacenamiento no local no es compatible con la mayoría de las apps y provocará un comportamiento indefinido, incluyendo fallos. ¿Continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ajout d'un conteneur dans un stockage non local n'est pas pris en charge par la plupart des applications et provoquera un comportement indéfini, y compris un plantage. Continuer ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルストレージ以外のストレージにコンテナを追加することは、ほとんどのアプリではサポートされておらず、クラッシュを始めとした不具合を引き起こす可能性があります。続行しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 저장소에 컨테이너를 추가할 경우, 앱이 충돌할 수 있습니다. 계속하시겠습니까?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawanie kontenera do pamięci masowej innej niż lokalna nie jest obsługiwane przez większość aplikacji i spowoduje nieoczekiwane zachowanie (w tym awarię). Kontynuować?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавление контейнера в нелокальном хранилище не поддерживается большинством приложений и приведет к неопределённому поведению, включая сбой. Продолжить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel olmayan bir depolama alanına konteyner eklemek çoğu uygulama tarafından desteklenmez ve çökme dahil olmak üzere tanımlanamayan davranışlara neden olur. Devam etmek istiyor musunuz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm thùng chứa vào bộ nhớ ngoài không được hỗ trợ bởi đa số app và sẽ gây ra những hành vi không xác định bao gồm bị sập. Tiếp tục?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加不处于本地存储的数据文件夹不被大多数App支持，且会导致包括崩溃等的未定义行为。要继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增不位於本地存儲的資料夾不被大多數應用程式支援，且會導致包含當機等自訂行為，要繼續嗎？"
          }
        }
      }
    },
