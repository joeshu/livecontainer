    "lc.tweakView.appFolderDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المِلَفّ يستعمل في تطبيق محدد. ضع مِلَفّ التعديل والتطبيق سوف يلتقط مِلَفّ التعديل بتكرار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist der appspezifische Ordner. Legen Sie den Tweak-Ordner fest, und die Gast-App übernimmt dessen Inhalt rekursiv."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the app-specific folder. Set the tweak folder and the guest app will pick them up recursively."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es la carpeta específica de la app. Configura la carpeta de tweaks y la app invitada los detectará recursivamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'agit du dossier spécifique à l'application. Définissez le dossier tweaks et l'application invitée les récupérera de manière récursive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è la cartella specifica per le applicazioni. Imposta la cartella tweak e l'app guest li raccoglierà ricorsivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはアプリ固有のフォルダです。調整フォルダを選択すると、ゲストアプリが自動的に取得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더는 개별 폴더입니다. 이곳에 트윅을 추가하고, 앱 설정에서 생성한 폴더를 선택하면, 해당 앱에만 트윅이 적용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj jest katalog z wybranymi aplikacjami. Skonfiguruj katalog z modyfikacjami, wtedy aplikacja gościnna rekurencyjnie je odbierze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é a pasta específica do aplicativo. Configure a página de ajustes e o aplicativo do usuário vai selecioná-los recursivamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это папка твиков для отдельного приложения. Выберите его в настройках приложения, и оно применит их рекурсивно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta är den app-specifik mapp. Ange tweak mapp och gäst-appen kommer att plocka upp dem rekursivt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, uygulamaya özgü klasördür. Tweak klasörünü ayarlayın, konuk uygulama bunları yinelemeli olarak alacaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là thư mục riêng cho một app. Đặt thư mục tweak và app sẽ tải từ ngoài vào trong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是App专用文件夹。将App的模块文件夹设置为本文件夹，则App在启动时会递归地加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是特定於應用程式的資料夾。 設定補丁資料夾，來賓應用程式將遞迴地拾取它們。"
          }
        }
      }
    },
    "lc.tweakView.globalFolderDesc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا هو المِلَفّ العام. جميع التعديلات الموجودة هنا سوف تُشغل في جميع التطبيقات. أنشئ مِلَفّ جديد أذا ترغب بتفعيل تعديل معين إلى تطبيق معين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist der globale Ordner. Alle hier abgelegten Tweaks werden in alle Gast-Apps injiziert. Erstellen Sie einen neuen Ordner, wenn Sie appspezifische Tweaks verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is the global folder. All tweaks put here will be injected to all guest apps. Create a new folder if you use app-specific tweaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es la carpeta global. Todos los tweaks colocados aquí se inyectarán en todas las apps invitadas. Crea una nueva carpeta si usas tweaks específicos de una app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'agit du dossier global. Tous les tweaks placés ici seront injectés dans toutes les applications invitées. Créez un nouveau dossier si vous utilisez des tweaks spécifiques à une application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è la cartella globale. Tutti i tweak messi qui saranno iniettati a tutte le app ospite. Crea una nuova cartella se usi tweak specifici per le app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはグローバルフォルダです。ここに置かれたすべての調整は、すべてのゲストアプリに注入されます。アプリ固有の調整を使用する場合は、新規フォルダを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더는 글로벌 폴더입니다. 이곳에 트윅을 추가할 경우 트윅이 모든 앱에 적용됩니다. 앱별로 트윅을 적용하고 싶으면 새로운 폴더를 만드세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj jest katalog globalny. Wszystkie modyfikacje znajdujące się tutaj będą wstrzykiwane do każdej aplikacji gościnnej. Stwórz nowy katalog, jeżeli chcesz używać modyfikacji tylko z wybranymi aplikacjami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é a pasta global. Todas as configurações colocadas aqui vão ser injetadas para todos os aplicativos do usuário. Crie uma pasta nova se você quer usar ajustes específicos para o aplicativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это глобальная папка. Все твики, расположенные в ней, будут применяться ко всем гостевым приложениям. Создайте новую папку для добавления твиков к отдельному приложению."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta är den globala mappen. Alla tweaks som läggs här kommer att injiceras till alla gästappar. Skapa en ny mapp om du använder app-specifika tweaks."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, genel klasördür. Buraya eklenen tüm tweakler tüm konuk uygulamalara uygulanacaktır. Uygulamaya özgü tweak kullanacaksanız yeni bir klasör oluşturun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là thư mục công cộng. Tất cả tweak để ở đây sẽ được inject vào tất cả app. Tạo thư mục mới nếu bạn dùng tweak dành riêng cho app nào đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是全局文件夹，这里的全部模块会被加载到所有App中。要为App单独加载模块，请新建文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是全域性資料夾。 這裡的所有補丁都將注入到所有來賓應用程式中。 如果您使用特定於應用程式的補訂，請建立一個新資料夾。"
          }
        }
      }
    },
